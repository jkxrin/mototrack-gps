<?xml version="1.0" encoding="utf-8"?>
<!--
  MotoTrack GPS Backup Rules Configuration
  Specifies files and preferences to include or exclude during automated Google Drive device backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
